# --- AsterPay endpoints (defaults are production; override for testnet/self-host) ---
ASTERPAY_MCP_URL=https://mcp-api.asterpay.io/mcp
ASTERPAY_API_URL=https://x402.asterpay.io

# --- Payment signing (REQUIRED for asterpay_pay) ---
# The agent's own USDC signing key. Store as an ENCRYPTED env var in your host
# (e.g. Vercel encrypted env). Never commit it; never put it in instructions.md.
# For production use a session key / smart account with an on-chain spend cap.
ASTERPAY_AGENT_PRIVATE_KEY=0x...

# Spend above this many USDC requires human approval (default 50).
ASTERPAY_MAX_AUTO_USDC=50

# --- Model provider (pick the one your agent.ts model uses) ---
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
